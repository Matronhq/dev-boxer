# dev-boxer configuration
# Copy to config.env and fill in your values, or run ./wizard.sh to generate.

# === User Setup ===
USERNAME=                           # Linux username to create
SSH_PUBLIC_KEY=                     # SSH public key (full key string)
SSH_PORT=2222                       # SSH port (default: 2222)
RDP_PASSWORD=                       # Password for XRDP login
RDP_ALLOWED_IP=                     # Optional: IP/CIDR for direct RDP firewall rule

# === Email Alerts (optional) ===
RESEND_API_KEY=                     # Resend API key (smtp password) for email alerts
RESEND_FROM_ADDRESS=                # From address (e.g., devbox@yourdomain.com)
ALERT_EMAIL=                        # Where to send alerts (e.g., you@example.com)

# === Matrix Bridge ===
MATRIX_MODE=bundled                 # "bundled" (Matron Server) or "byoh" (external homeserver)

# -- Bundled Matron Server settings (used when MATRIX_MODE=bundled) --
MATRIX_SERVER_DOMAIN=               # e.g., matrix.yourdomain.com
MATRIX_BOT_USERNAME=claude-bot      # Bot account username
MATRIX_USER_USERNAME=               # Your Matrix username
MATRIX_USER_PASSWORD=               # Your Matrix password

# -- BYOH settings (used when MATRIX_MODE=byoh) --
# MATRIX_HOMESERVER_URL=            # e.g., https://matrix.org
# MATRIX_BOT_ACCESS_TOKEN=          # Bot's access token
# MATRIX_ALLOWED_USER_IDS=          # Comma-separated Matrix user IDs

# === Cloudflare Tunnel ===
CLOUDFLARE_API_TOKEN=               # Used during setup ONLY, then deleted from this file
CLOUDFLARE_DOMAIN=                  # Your Cloudflare domain (e.g., yourdomain.com)
CF_HOSTNAME_MAIN=                   # Main hostname (e.g., dev.yourdomain.com)
CF_HOSTNAME_MATRIX=                 # Matrix hostname (e.g., matrix.yourdomain.com)
CF_HOSTNAME_VIEWER=                 # File viewer hostname (e.g., viewer.yourdomain.com)

# === Generated (do not edit manually) ===
# HMAC_SECRET=                      # Auto-generated by wizard
# CLOUDFLARE_TUNNEL_ID=             # Set during tunnel creation
# MATRIX_BOT_ACCESS_TOKEN_BUNDLED=  # Set during Matrix account registration
# MATRIX_BRIDGE_ROOM_ID=            # Set during Matrix room creation
