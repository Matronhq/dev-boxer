[Unit]
Description=Claude Matrix Bridge File Viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USERNAME}}
WorkingDirectory=/home/{{USERNAME}}/claude-matrix-bridge
EnvironmentFile=/home/{{USERNAME}}/claude-matrix-bridge/.env
ExecStart=/usr/bin/node /home/{{USERNAME}}/claude-matrix-bridge/viewer/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
