{
  "mcpServers": {
    "ask-user": {
      "command": "node",
      "args": ["/home/{{USERNAME}}/matron-bridge/ask-user.js"],
      "env": {
        "BRIDGE_API_URL": "http://127.0.0.1:9802"
      }
    },
    "chrome-devtools": {
      "command": "xvfb-run",
      "args": ["--auto-servernum", "--server-args=-screen 0 1920x1080x24", "npx", "chrome-devtools-mcp"],
      "env": {
        "DISPLAY": "",
        "HOME": "/home/{{USERNAME}}"
      }
    }
  }
}
